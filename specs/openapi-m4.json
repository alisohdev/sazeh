    "/v1/finance/draft": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FinanceDraft"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Persisted result; retries replay the same result"
          },
          "400": {
            "description": "Validation failure"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "Version, identity, evidence or dependency conflict"
          }
        }
      }
    },

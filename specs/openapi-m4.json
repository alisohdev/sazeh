    "/v1/attachments/{id}/complete": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized attachment result"
          },
          "201": {
            "description": "Idempotent verified completion"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "File not ready or dependency conflict"
          }
        }
      }
    },
